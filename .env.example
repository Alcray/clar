# Docker quick start. For native installation use OLLAMA_BASE_URL=http://127.0.0.1:11434.
DEFAULT_PROVIDER=local
LOCAL_PROVIDER=ollama
LOCAL_MODEL=qwen2.5vl:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_API_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_API_KEY_ENV=LOCAL_API_KEY
LOCAL_API_KEY=
LOCAL_CONTEXT_TOKENS=8192
LOCAL_THINKING=default
LOCAL_TEMPERATURE=0

# Optional Google providers. Keys are server-only; never put them in an extension build.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
VERTEX_API_KEY=
VERTEX_MODEL=gemini-3.5-flash
MODEL_THINKING=low
MODEL_TEMPERATURE=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=4096

# Native server defaults. Compose deliberately overrides HOST and PUBLIC_MODE.
HOST=127.0.0.1
PORT=8765
PUBLIC_MODE=0
PUBLIC_HOST=
ALLOWED_HOSTS=localhost,127.0.0.1,::1
CLAR_RUNTIME_DIR=.runtime
CLAR_INVITE_DAILY_LIMIT=30
CLAR_GLOBAL_DAILY_LIMIT=90

# Docker host binding and the backend baked into the downloadable extension.
# For a custom port or HTTPS domain update CLAR_BACKEND before rebuilding.
CLAR_BIND_IP=127.0.0.1
CLAR_PORT=8765
CLAR_BACKEND=http://localhost:8765
