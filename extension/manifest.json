{
  "manifest_version": 3,
  "name": "CLAR \u2014 Facebook post checker",
  "version": "0.5.1",
  "minimum_chrome_version": "141",
  "description": "Check Facebook posts against evidence and explain opinions, persuasion cues, and apparent purpose.",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://*.fbcdn.net/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open CLAR",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "presentation.js",
        "selectors.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.fbcdn.net https://www.gstatic.com; connect-src http://127.0.0.1:8765 http://localhost:8765 https://*.fbcdn.net; frame-src 'self'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
